FROM python:3.14-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 GEOFLOW_ROOT=/app GEOFLOW_ARTIFACTS=/tmp/geoflow
COPY pyproject.toml requirements-web.txt ./
COPY src ./src
RUN pip install --no-cache-dir -c requirements-web.txt ".[web,earth]" && useradd --create-home geoflow
COPY configs ./configs
COPY benchmarks/web-demo ./benchmarks/web-demo
COPY benchmarks/hpc-results.json ./benchmarks/hpc-results.json
USER geoflow
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "from urllib.request import urlopen; urlopen('http://127.0.0.1:8000/api/v1/health',timeout=3).read()"
CMD ["python","-m","uvicorn","geoflow.web.api:app","--host","0.0.0.0","--port","8000","--workers","1","--limit-concurrency","32"]

